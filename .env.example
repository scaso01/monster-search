# monster-search configuration
# Copy to .env and set values for your environment.
# All variables are optional — defaults are shown below.

# Semantic Scholar academic paper search (free API key — no key = instant 429 on VPN/shared IPs)
# Sign up at: https://www.semanticscholar.org/product/api#api-key
MONSTER_SEMANTIC_SCHOLAR_API_KEY=
MONSTER_SEMANTIC_SCHOLAR_TIMEOUT=15

# searchcode.com per-repo code intelligence (no API key required)
# Usage: monster-search --engine searchcode_repo --repo https://github.com/owner/repo <query>
MONSTER_SEARCHCODE_TIMEOUT=15

# grep.app public code search — DISABLED by default.
# grep.app is permanently ASN-blocked from NordVPN exits (HTTP 429 in <200ms
# even after exit refresh).  Set to true only if running without a VPN.
MONSTER_GREPAPP_ENABLED=
# Optional: set a descriptive User-Agent so grep.app can identify your instance.
# Example: MONSTER_GREPAPP_USER_AGENT=monster-search/myhost (self-hosted research tool)
MONSTER_GREPAPP_USER_AGENT=
MONSTER_GREPAPP_TIMEOUT=15

# SearXNG base URL
MONSTER_SEARXNG_URL=http://localhost:8080

# Perplexica base URL
MONSTER_PERPLEXICA_URL=http://localhost:3001

# Perplexica model name (must match a model available in your provider)
MONSTER_PERPLEXICA_MODEL=

# Perplexica search timeout in seconds (includes LLM inference time)
MONSTER_PERPLEXICA_TIMEOUT=300

# Default search engine: searxng, perplexica, local_researcher, marginalia, crawl, perplexity, news, all
MONSTER_DEFAULT_ENGINE=all

# Default max results returned
MONSTER_MAX_RESULTS=5

# HTTP timeout in seconds
MONSTER_TIMEOUT=90

# Local Deep Researcher (LangGraph) settings
MONSTER_LOCAL_RESEARCHER_URL=http://localhost:8300
MONSTER_LOCAL_RESEARCHER_TIMEOUT=600

# Marginalia independent search engine (no auth, free, CC-BY-NC-SA 4.0)
MONSTER_MARGINALIA_URL=https://api.marginalia.nu
MONSTER_MARGINALIA_TIMEOUT=15

# Mwmbl independent open-source web index (no auth, free, keyless public API)
MONSTER_MWMBL_URL=https://api.mwmbl.org
MONSTER_MWMBL_TIMEOUT=10

# Crawl4AI page content extraction (Docker on Monster)
MONSTER_CRAWL4AI_URL=http://localhost:11235
MONSTER_CRAWL4AI_TIMEOUT=120

# Perplexity AI synthesis (needs a logged-in perplexity.ai session)
# PREFERRED: read the live session cookie from a local browser profile so it
# self-heals on every login — no long-lived secret on disk. Firefox is most
# reliable on Windows (Chrome/Edge use App-Bound Encryption, which breaks
# cookie extraction). Value is "browser" or "browser:profile", e.g. "firefox".
MONSTER_PERPLEXITY_COOKIES_FROM_BROWSER=
# FALLBACK: static __Secure-next-auth.session-token cookie (manual ~monthly
# refresh). Only used when the browser source above is unset or fails.
MONSTER_PERPLEXITY_SESSION_TOKEN=
MONSTER_PERPLEXITY_TIMEOUT=120

# changedetection.io URL monitoring (self-hosted, Docker)
MONSTER_CHANGEDETECTION_URL=http://localhost:8086
MONSTER_CHANGEDETECTION_API_KEY=

# PriceGhost — self-hosted price tracker (Docker)
MONSTER_PRICEGHOST_URL=http://localhost:3100
MONSTER_PRICEGHOST_TIMEOUT=15
MONSTER_PRICEGHOST_EMAIL=
MONSTER_PRICEGHOST_PASSWORD=

# Remote host for the two engines that run over SSH rather than HTTP: fyin,
# and archive.org when your own exit IP is one it rate-limits. Anything ssh
# accepts, e.g. user@host. Leave empty to keep fyin off and query archive.org
# directly, which is what most setups want.
MONSTER_SSH_HOST=
# Optional shell file sourced on that host before fyin runs, for the API keys
# it expects in its environment.
MONSTER_FYIN_ENV_FILE=

# Amazon Deals — scraper (no auth needed)
MONSTER_AMAZON_DEALS_TIMEOUT=30

# Newegg — scraper (no auth needed)
MONSTER_NEWEGG_TIMEOUT=30
